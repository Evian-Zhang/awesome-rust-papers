author = {Kang, Zhehao and Zhu, Qianyu and Mou, Wenrui and Wang, Bang and Zhang, Xiaogang and Huang, Haojun},
title = {MinsC2Rust: LLM-driven project-level code migration from C to safe Rust},
year = {2026},
