author = {Jiang, Renshuang and Dong, Pan and Ding, Yan and Wei, Ran and Jiang, Zhe},
title = {Thetis-lathe: Guidance on Reducing Residual Safety Obstacle in System Software from Rust Source Codes},
year = {2025},
