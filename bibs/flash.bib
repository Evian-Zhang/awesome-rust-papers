pages = {642-660},
abstract = { Rust now underpins critical infrastructure. Although Rust's ownership rules address broad classes of memory errors, liveness hazards such as deadlock and starvation remain. Existing work has started to detect liveness hazards in synchronous Rust. They use MIR-based lock liveness and order analysis to report double locking and conflicting lock orders. Some studies combine pointer analysis with a signal-lock graph to detect resource and communication deadlocks. However, these approaches cannot apply to real-world asynchronous Rust. Synchronous liveness hazards arise from blocking between threads, while asynchronous liveness hazards depend on whether suspended tasks can continue making progress. We present FLASH, as far as we know, the first static analyzer for asynchronous liveness hazards in real-world Rust. FLASH first extracts asynchronous information from MIR to identify lock acquisition, suspension points, future-producing call sites, and construct field-sensitive lock identities, as the basis for the following steps. It then builds a wait-for graph to represent the asynchronous semantics in Rust. Moreover, FLASH performs asynchronous liveness hazard detection based on the wait-for graph. We evaluate FLASH on eight popular asynchronous Rust systems, totaling 3.5 MLOC and 129.6K GitHub stars. FLASH reports 267 new liveness hazards, and 145 of them are true positives (54.3% precision). The analysis shows that they can cause 35x to 532x service throughput degradation or complete service unavailability. As of submission, the maintainers have acknowledged or fixed 30 of our findings. Eight of our findings have been cataloged in official vulnerability databases. },
keywords = {asynchronous rust;liveness hazards;deadlock/starvation;static analysis;mir},
doi = {10.1109/SP68766.2027.00034},
url = {https://doi.ieeecomputersociety.org/10.1109/SP68766.2027.00034},
