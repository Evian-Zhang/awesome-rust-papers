abstract = {Rust permits the use of unsafe code, which can violate both memory safety and concurrency safety. Prior work investigates unsafe code in Rust projects and provides insights into what, how, and why it is used. However, these studies provide only static metrics about unsafe code, while lacking an understanding of its dynamic behaviors at execution time. In parallel, many security mechanisms have been proposed to mitigate unsafe code in Rust. But the evaluations of these tools are suboptimal due to the lack of a benchmark suite that emphasizes unsafe code.In this paper, we present the first empirical study of the runtime behavior of unsafe code in real-world Rust projects. We develop a dynamic analysis framework that programmers can use to answer key questions about unsafe code at execution time. Moreover, using the dynamic analysis framework, we curate the first benchmark suite specifically designed for evaluating the performance and memory overhead of security defenses against unsafe code in Rust.},
booktitle = {Proceedings of the 2026 ACM SIGOPS Annual Technical Conference},
pages = {177–192},
