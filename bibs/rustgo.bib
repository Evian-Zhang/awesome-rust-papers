author = {Yu, Dongyeon and Min, Jiun and Na, Yewan and Kim, Mijung and Kim, Taegyu and Jeon, Yuseok},
title = {RustGo: Fairly Directed Greybox Fuzzing for Enforcing Rust Memory Safety},
year = {2026},
